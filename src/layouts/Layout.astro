---
import config from "@/config";
import {getAssetPath} from "@/utils/withBase";
import "@/styles/studio.css";
type Props={title?:string;description?:string;ogImage?:string;canonicalURL?:string};
const {title=config.site.title,description=title===config.site.title?config.site.description:`${title}。查阅 Clash 中文下载指引、配置文章与相关主题。`,canonicalURL=new URL(Astro.url.pathname,Astro.site).href,ogImage}=Astro.props;
const preview=!process.env.SITE_URL || /localhost|127\.0\.0\.1/.test(process.env.SITE_URL);
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content={preview||/\/404(?:\.html|\/)?$/.test(Astro.url.pathname)?'noindex,follow':'index,follow'}/><link rel="canonical" href={canonicalURL}/><link rel="icon" type="image/svg+xml" href={getAssetPath('favicon.svg')}/><link rel="sitemap" href={getAssetPath('sitemap-index.xml')}/><link rel="alternate" type="application/rss+xml" title="Clash 中文网 RSS" href={getAssetPath('rss.xml')}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalURL}/>{ogImage&&<meta property="og:image" content={ogImage}/>}<meta name="theme-color" content="#fbf8f2"/><slot name="head"/></head><body><slot/></body></html>
