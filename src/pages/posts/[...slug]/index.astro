---
import {getCollection,render} from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import {getSortedPosts} from "@/utils/getSortedPosts";
import {getPostSlug} from "@/utils/getPostPaths";
import {getAssetPath as url} from "@/utils/withBase";
export async function getStaticPaths(){return getSortedPosts(await getCollection('posts')).map(post=>({params:{slug:getPostSlug(post.id,post.filePath)},props:{post}}));}
const {post}=Astro.props;const {Content,headings}=await render(post);const related=getSortedPosts(await getCollection('posts')).filter(p=>p.id!==post.id).slice(0,3);
---
<PostLayout title={`${post.data.title} | Clash 中文网`} description={post.data.description} pubDatetime={post.data.pubDatetime} modDatetime={post.data.modDatetime}><Header/><main id="main-content" class="shell article-page" data-pagefind-body><a class="back-link" href={url('posts/')}>← 返回笔记列表</a><header class="article-heading"><span class="eyebrow">{post.data.tags.join(' / ')}</span><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="article-byline"><span>{post.data.author}</span><time datetime={post.data.pubDatetime.toISOString()}>{post.data.pubDatetime.toISOString().slice(0,10)}</time></div></header><div class="reading-layout"><article class="reading-body app-prose"><Content/></article><aside class="reading-toc"><span class="eyebrow">本文目录</span><nav aria-label="文章目录">{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text}</a>)}</nav><div class="toc-note">下载与版本要求请以开发者当前说明为准。</div></aside></div><section class="related-section"><div class="section-top"><h2>接着读一篇。</h2></div><ul class="post-grid">{related.map(p=><Card {...p} variant="h3"/>)}</ul></section></main><Footer/></PostLayout>
