---
import {getCollection} from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import {getSortedPosts} from "@/utils/getSortedPosts";
import {getAssetPath as url} from "@/utils/withBase";
const posts=getSortedPosts(await getCollection('posts'));
const topics=[['official/','官网入口','开发者仓库与发行来源'],['mobile/','手机版','Android 安装与连接'],['desktop/','电脑版','Windows 安装与配置'],['tutorials/','使用教程','订阅、规则与故障排查'],['recommend/','机场推荐','选购要点与订阅配置']];
---
<Layout title="Clash 中文网｜软件下载与配置教程"><Header/><main id="main-content">
<section class="search-hero"><div class="shell hero-inner"><p class="hero-kicker">Clash 中文知识书架</p><h1>Clash 中文网<br/>软件下载与配置教程</h1><p class="hero-description">从开发者发布源找到客户端，按设备读懂安装、订阅和代理设置。</p><form class="knowledge-search" action={url('search/')} role="search"><label class="sr-only" for="knowledge-query">搜索 Clash 教程</label><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="knowledge-query" name="q" type="search" placeholder="输入问题，例如：订阅导入、系统代理"/><button type="submit">搜索</button></form><div class="search-hints"><span>常用检索</span><a href={url('search/?q=订阅')}>订阅导入</a><a href={url('search/?q=规则')}>规则模式</a><a href={url('search/?q=连接')}>连接排查</a></div></div></section>
<section class="shell topic-shelf" aria-label="按主题浏览">{topics.map(([href,title,desc])=><a href={url(href)}><span class="shelf-mark" aria-hidden="true"></span><h2>{title}</h2><p>{desc}</p></a>)}</section>
<div class="shell library-layout"><aside class="starter-shelf"><div class="shelf-label">初次使用</div><h2>从设备开始。</h2><p>先选适合设备的客户端，再导入你已有的配置。</p><a class="device-link" href={url('mobile/')}><strong>Android 手机</strong><span>安装包与 VPN 授权</span></a><a class="device-link" href={url('desktop/')}><strong>Windows 电脑</strong><span>程序架构与系统代理</span></a><a class="all-downloads" href={url('download/')}>浏览全部客户端下载</a><div class="reading-path"><h3>建议阅读顺序</h3><ol><li><a href={url('posts/official-entry/')}>核对客户端下载来源</a></li><li><a href={url('posts/subscription-guide/')}>导入并启用订阅配置</a></li><li><a href={url('posts/proxy-modes/')}>理解规则与代理模式</a></li></ol></div></aside><section class="library-notes"><div class="section-top"><div><p class="shelf-label">操作笔记</p><h2>把每一步弄清楚。</h2></div><a class="quiet-link" href={url('posts/')}>全部文章</a></div><ul class="post-grid">{posts.map(post=><Card {...post} variant="h3"/>)}</ul></section></div>
<section class="shell help-strip"><div><h2>已经连接，仍然打不开？</h2><p>按网络、配置、代理接管和目标请求逐项定位。</p></div><a class="button primary" href={url('posts/connection-check/')}>查看连接排查指南</a></section></main><Footer/></Layout>
