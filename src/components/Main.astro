---
type Props={pageTitle:string|[string,string];pageDesc?:string;class?:string};const {pageTitle,pageDesc,class:className}=Astro.props;
---
<main id="main-content" class:list={['shell page-main',className]}><header class="page-heading"><span class="eyebrow">CLASH BOOKMARKS</span><h1>{pageTitle}</h1>{pageDesc&&<p>{pageDesc}</p>}</header><slot/></main>
