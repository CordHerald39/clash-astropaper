---
import type {CollectionEntry} from "astro:content";
import {getPostUrl} from "@/utils/getPostPaths";
type Props={variant?:'h2'|'h3'}&CollectionEntry<'posts'>;
const {variant:Heading='h2',id,data,filePath}=Astro.props;
---
<li class="post-tile"><a class="post-tile-link" href={getPostUrl(id,filePath,Astro.currentLocale)}><div class="tile-meta"><span>{data.tags[0]||'使用笔记'}</span><time datetime={data.pubDatetime.toISOString()}>{data.pubDatetime.toISOString().slice(0,10)}</time></div><Heading>{data.title}</Heading><p>{data.description}</p><span class="tile-more">阅读这篇文章 <b aria-hidden="true">↗</b></span></a></li>
