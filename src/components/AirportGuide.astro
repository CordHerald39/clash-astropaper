---
import rawData from '../data/airports.json';
interface Plan {name:string;price:number;billing:string;traffic:string;reset:string;note?:string}
interface Provider {id:string;name:string;summary:string;scenario:string;url:string;updated:string;coupon?:string|null;couponNote?:string;plans:Plan[];features?:string[];regions?:string[];conditions?:string[]}
const data=rawData as {updated:string;note:string;providers:Provider[];faq:{q:string;a:string}[]};
const {link,download,tutorial}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).href;
const hasProviders=data.providers.length>0;
const schema=[...(hasProviders?[{'@context':'https://schema.org','@type':'ItemList',name:'机场套餐比较',itemListOrder:'https://schema.org/ItemListUnordered',itemListElement:data.providers.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.name,url:canonical+'#'+p.id}))}]:[]),{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:new URL(import.meta.env.BASE_URL,Astro.site).href},{'@type':'ListItem',position:2,name:'机场推荐',item:canonical}]}];
---
<div class="airport-guide">
<p class="airport-note">{data.note}</p>
<nav class="airport-jumps" aria-label="本页目录">{hasProviders&&<><a href="#compare">套餐对比</a><a href="#providers">服务信息</a></>}<a href="#choose">怎么选择</a><a href="#setup">导入订阅</a><a href="#faq">常见问题</a></nav>
{hasProviders&&<><section class="airport-directory" aria-labelledby="directory-title"><h2 id="directory-title">找到你要了解的机场</h2><p>收录 {data.providers.length} 个品牌，按名称定位套餐与官网入口。列表顺序用于查找，不代表速度或服务排名。</p><nav class="airport-brand-index" aria-label="机场品牌索引">{data.providers.map(p=><a href={'#'+p.id}>{p.name}</a>)}</nav></section><section id="compare"><h2>先比较实际扣款和流量周期</h2><p>同样写着 100 GB，可能是每月重置，也可能是一次性额度。下表列出各品牌的入门套餐和实际标价，完整套餐见对应品牌条目；年付金额没有折算成月价。</p><div class="airport-table" role="region" aria-label="机场套餐对比表" tabindex="0"><table><caption>各品牌入门套餐：人民币，资料更新日期 {data.updated}</caption><thead><tr><th scope="col">服务与套餐</th><th scope="col">实际扣款</th><th scope="col">计费方式</th><th scope="col">流量</th><th scope="col">重置周期</th></tr></thead><tbody>{data.providers.flatMap(p=>p.plans.slice(0,1).map(plan=><tr><th scope="row"><a href={'#'+p.id}>{p.name}</a><small>{plan.name}</small></th><td>¥{plan.price}</td><td>{plan.billing}</td><td>{plan.traffic}</td><td>{plan.reset}</td></tr>))}</tbody></table></div></section>
<section id="providers"><h2>服务与套餐信息</h2><p>套餐按实际扣款、流量和计费周期比较。每个条目由本站编辑填写，付款前请核对服务商的实际条款。</p>{data.providers.map(p=><article class="airport-provider" id={p.id}><header><h3>{p.name}</h3><span>{p.scenario}</span></header><p>{p.summary}</p>{p.features && p.features.length>0&&<ul class="airport-features">{p.features.map(feature=><li>{feature}</li>)}</ul>}{p.regions && p.regions.length>0&&<p><strong>节点地区：</strong>{p.regions.join('、')}。</p>}<details class="airport-plans"><summary>查看 {p.name} 的 {p.plans.length} 款套餐与计费条件</summary><div class="airport-table" role="region" aria-label={p.name+'套餐表'} tabindex="0"><table><caption>{p.name} 套餐明细</caption><thead><tr><th scope="col">套餐</th><th scope="col">实际扣款</th><th scope="col">计费方式</th><th scope="col">流量</th><th scope="col">重置周期</th></tr></thead><tbody>{p.plans.map(plan=><tr><th scope="row">{plan.name}{plan.note&&<small>{plan.note}</small>}</th><td>¥{plan.price}</td><td>{plan.billing}</td><td>{plan.traffic}</td><td>{plan.reset}</td></tr>)}</tbody></table></div>{p.conditions && p.conditions.length>0&&<ul>{p.conditions.map(condition=><li>{condition}</li>)}</ul>}</details>{p.coupon&&<p class="airport-coupon">优惠码 <code>{p.coupon}</code> <span>{p.couponNote}</span></p>}<p class="airport-source">官网域名：{new URL(p.url).hostname} · 更新日期 {p.updated}。</p><a class="airport-action" href={p.url} rel="nofollow noopener">访问官网</a></article>)}</section></>}
<section id="choose"><h2>按使用方式选套餐</h2><dl class="airport-advice"><dt>只是偶尔查资料</dt><dd>先比较小流量月付或一次性额度。确认有效期、闲置规则与购买后是否立即开始计时，避免买入很快到期的流量。</dd><dt>每天办公和学习</dt><dd>用一个月观察真实用量。开会、视频与云盘同步可能比网页浏览耗费更多流量；检查同时在线设备限制和超过额度后的处理方式。</dd><dt>观看视频或使用特定应用</dt><dd>用自己的账号、常用地区和常用时段检查目标应用。看到“支持”仍需核对是否限指定节点、地区或套餐；记录实际体验再续费。</dd><dt>路由器或全家多设备</dt><dd>同时核对协议兼容性、设备限制与流量倍率。路由器自动更新订阅时，应保留本地备份，并检查规则更新后是否影响局域网访问。</dd></dl><h3>付款前逐项确认</h3><ol><li>入口域名和支付页面是否一致，能否找到明确的套餐条款与客服入口。</li><li>实际付款总额、续费价格、流量重置日期与节点倍率。</li><li>是否支持所用客户端，能否提供 Clash / Mihomo 兼容订阅。</li><li>试用、退款、工单与维护公告的具体规则。</li><li>先用短周期检查需求，再决定是否扩大预算。</li></ol></section>
<section id="setup"><h2>订阅购买后，按顺序完成配置</h2><ol><li>从<a href={link(download)}>客户端下载页</a>选择适合设备的程序，核对发布仓库和安装包架构。</li><li>在服务商控制台复制兼容订阅链接，导入客户端，检查节点列表和账户流量信息。</li><li>选择节点，按客户端提示启用系统代理或 VPN。先使用规则模式，确认访问路径。</li><li>打开常用网站，检查日志和请求去向；遇到异常按<a href={link(tutorial)}>使用教程</a>排查。</li></ol><p>不要将带令牌的订阅地址输入不熟悉的在线转换页面。需要转换时先看服务商是否提供适配订阅，或使用可信的本地工具。</p></section>
<section id="faq"><h2>机场订阅常见问题</h2>{data.faq.map(item=><details class="airport-faq"><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\u003c')}/>
</div>
<style>
.airport-brand-index{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:0 20px;border-top:1px solid color-mix(in srgb,currentColor 18%,transparent)}.airport-brand-index a{display:block;padding:12px 0;border-bottom:1px solid color-mix(in srgb,currentColor 12%,transparent)}.airport-plans{margin:20px 0}.airport-plans>summary{cursor:pointer;font-weight:700;padding:14px 0}.airport-plans .airport-table{margin-top:12px}.airport-features{display:flex;flex-wrap:wrap;gap:4px 28px}.airport-guide{max-width:1120px;margin:auto;padding:28px clamp(18px,4vw,48px);color:inherit;line-height:1.8}.airport-guide section{margin:3rem 0;scroll-margin-top:100px}.airport-guide h2{font-size:1.7rem;margin:0 0 16px;font-weight:750}.airport-guide h3{font-size:1.3rem;margin:0}.airport-guide p{max-width:78ch}.airport-note{border-left:4px solid currentColor;padding:12px 20px;background:color-mix(in srgb,currentColor 4%,transparent)}.airport-jumps{display:flex;flex-wrap:wrap;gap:12px 24px;padding:20px 0;border-bottom:1px solid color-mix(in srgb,currentColor 18%,transparent)}.airport-table{overflow:auto;border:1px solid color-mix(in srgb,currentColor 20%,transparent);border-radius:8px}.airport-table table{width:100%;border-collapse:collapse;min-width:650px}.airport-table caption{text-align:left;padding:16px;font-size:.9rem}.airport-table th,.airport-table td{text-align:left;padding:16px;border-top:1px solid color-mix(in srgb,currentColor 12%,transparent)}.airport-table thead{background:color-mix(in srgb,currentColor 6%,transparent)}.airport-table small{display:block;font-weight:400}.airport-provider{padding:26px 0;border-bottom:1px solid color-mix(in srgb,currentColor 18%,transparent);scroll-margin-top:100px}.airport-provider header{display:flex;align-items:baseline;flex-wrap:wrap;gap:14px}.airport-provider header span,.airport-source{font-size:.9rem}.airport-provider ul,.airport-guide ol,.airport-guide ul{padding-left:24px}.airport-coupon code{font-weight:700;padding:4px 9px;background:color-mix(in srgb,currentColor 8%,transparent)}.airport-coupon span{display:block;margin-top:8px;font-size:.9rem}.airport-action{display:inline-block;padding:8px 0;font-weight:700}.airport-advice dt{font-weight:750;margin-top:20px}.airport-advice dd{margin:4px 0 0;max-width:78ch}.airport-faq{padding:18px 0;border-bottom:1px solid color-mix(in srgb,currentColor 15%,transparent)}.airport-faq summary{cursor:pointer;font-weight:650}.airport-faq p{margin:12px 0 0}.airport-guide a{text-decoration:underline;text-underline-offset:3px}.airport-guide :focus-visible{outline:3px solid currentColor;outline-offset:4px}@media(max-width:600px){.airport-guide{padding:22px 16px}.airport-guide h2{font-size:1.4rem}.airport-provider header{display:block}.airport-provider header span{display:block;margin-top:6px}}
</style>

