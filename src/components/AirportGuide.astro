---
import data from '../data/airports.json';
const {link,download,tutorial}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).href;
const schema=[{'@context':'https://schema.org','@type':'ItemList',name:'机场套餐比较',itemListOrder:'https://schema.org/ItemListUnordered',itemListElement:data.providers.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.name,url:canonical+'#'+p.id}))},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:new URL(import.meta.env.BASE_URL,Astro.site).href},{'@type':'ListItem',position:2,name:'机场推荐',item:canonical}]}];
---
<div class="airport-guide">
<p class="airport-note">{data.note}</p>
<nav class="airport-jumps" aria-label="本页目录"><a href="#compare">套餐对比</a><a href="#providers">服务信息</a><a href="#choose">怎么选择</a><a href="#setup">导入订阅</a><a href="#faq">常见问题</a></nav>
<section id="compare"><h2>先比较实际扣款和流量周期</h2><p>同样写着 100 GB，可能是每月重置，也可能是一次性额度。下表显示一个计费周期的实际标价；年付金额没有折算成月价。</p><div class="airport-table" role="region" aria-label="机场套餐对比表" tabindex="0"><table><caption>公开套餐信息：人民币，记录日期 {data.updated}</caption><thead><tr><th scope="col">服务与套餐</th><th scope="col">实际扣款</th><th scope="col">计费方式</th><th scope="col">流量</th><th scope="col">重置周期</th></tr></thead><tbody>{data.providers.flatMap(p=>p.plans.map(plan=><tr><th scope="row"><a href={'#'+p.id}>{p.name}</a><small>{plan.name}</small></th><td>¥{plan.price}</td><td>{plan.billing}</td><td>{plan.traffic}</td><td>{plan.reset}</td></tr>))}</tbody></table></div></section>
<section id="providers"><h2>服务与套餐信息</h2><p>套餐按实际扣款、流量和计费周期比较。每个条目保留资料来源与记录日期，付款前可逐项核对。</p>{data.providers.map(p=><article class="airport-provider" id={p.id}><header><h3>{p.name}</h3><span>{p.scenario}</span></header><p>{p.summary}</p><ul>{p.plans.map(plan=><li><strong>{plan.name}</strong>：¥{plan.price} / {plan.billing}，{plan.traffic}，{plan.reset}。</li>)}</ul>{p.coupon&&<p class="airport-coupon">优惠码 <code>{p.coupon}</code> <span>{p.couponNote}</span></p>}<p class="airport-source">信息来源：<a href={p.source} rel="nofollow noopener">{p.sourceName}</a>；记录日期 {p.updated}。</p><a class="airport-action" href={p.url} rel="nofollow noopener">查看套餐资料</a></article>)}</section>
<section id="choose"><h2>按使用方式选套餐</h2><dl class="airport-advice"><dt>只是偶尔查资料</dt><dd>先比较小流量月付或一次性额度。确认有效期、闲置规则与购买后是否立即开始计时，避免买入很快到期的流量。</dd><dt>每天办公和学习</dt><dd>用一个月观察真实用量。开会、视频与云盘同步可能比网页浏览耗费更多流量；检查同时在线设备限制和超过额度后的处理方式。</dd><dt>观看视频或使用特定应用</dt><dd>用自己的账号、常用地区和常用时段检查目标应用。看到“支持”仍需核对是否限指定节点、地区或套餐；记录实际体验再续费。</dd><dt>路由器或全家多设备</dt><dd>同时核对协议兼容性、设备限制与流量倍率。路由器自动更新订阅时，应保留本地备份，并检查规则更新后是否影响局域网访问。</dd></dl><h3>付款前逐项确认</h3><ol><li>入口域名和支付页面是否一致，能否找到明确的套餐条款与客服入口。</li><li>实际付款总额、续费价格、流量重置日期与节点倍率。</li><li>是否支持所用客户端，能否提供 Clash / Mihomo 兼容订阅。</li><li>试用、退款、工单与维护公告的具体规则。</li><li>先用短周期检查需求，再决定是否扩大预算。</li></ol></section>
<section id="setup"><h2>订阅购买后，按顺序完成配置</h2><ol><li>从<a href={link(download)}>客户端下载页</a>选择适合设备的程序，核对发布仓库和安装包架构。</li><li>在服务商控制台复制兼容订阅链接，导入客户端，检查节点列表和账户流量信息。</li><li>选择节点，按客户端提示启用系统代理或 VPN。先使用规则模式，确认访问路径。</li><li>打开常用网站，检查日志和请求去向；遇到异常按<a href={link(tutorial)}>使用教程</a>排查。</li></ol><p>不要将带令牌的订阅地址输入不熟悉的在线转换页面。需要转换时先看服务商是否提供适配订阅，或使用可信的本地工具。</p></section>
<section id="faq"><h2>机场订阅常见问题</h2>{data.faq.map(item=><details class="airport-faq"><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>
<section><h2>资料与更新说明</h2><p>应用体验取决于节点、地区和使用时段。套餐与优惠以服务商结算页面为准，续费前建议重新核对流量、价格和适用条件。</p><ul><li><a href="https://yifenjichang.net/rankings/" rel="nofollow noopener">一分机场：公开套餐资料</a></li></ul></section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\u003c')}/>
</div>
<style>
.airport-guide{max-width:1120px;margin:auto;padding:28px clamp(18px,4vw,48px);color:inherit;line-height:1.8}.airport-guide section{margin:3rem 0;scroll-margin-top:100px}.airport-guide h2{font-size:1.7rem;margin:0 0 16px;font-weight:750}.airport-guide h3{font-size:1.3rem;margin:0}.airport-guide p{max-width:78ch}.airport-note{border-left:4px solid currentColor;padding:12px 20px;background:color-mix(in srgb,currentColor 4%,transparent)}.airport-jumps{display:flex;flex-wrap:wrap;gap:12px 24px;padding:20px 0;border-bottom:1px solid color-mix(in srgb,currentColor 18%,transparent)}.airport-table{overflow:auto;border:1px solid color-mix(in srgb,currentColor 20%,transparent);border-radius:8px}.airport-table table{width:100%;border-collapse:collapse;min-width:650px}.airport-table caption{text-align:left;padding:16px;font-size:.9rem}.airport-table th,.airport-table td{text-align:left;padding:16px;border-top:1px solid color-mix(in srgb,currentColor 12%,transparent)}.airport-table thead{background:color-mix(in srgb,currentColor 6%,transparent)}.airport-table small{display:block;font-weight:400}.airport-provider{padding:26px 0;border-bottom:1px solid color-mix(in srgb,currentColor 18%,transparent);scroll-margin-top:100px}.airport-provider header{display:flex;align-items:baseline;flex-wrap:wrap;gap:14px}.airport-provider header span,.airport-source{font-size:.9rem}.airport-provider ul,.airport-guide ol,.airport-guide ul{padding-left:24px}.airport-coupon code{font-weight:700;padding:4px 9px;background:color-mix(in srgb,currentColor 8%,transparent)}.airport-coupon span{display:block;margin-top:8px;font-size:.9rem}.airport-action{display:inline-block;padding:8px 0;font-weight:700}.airport-advice dt{font-weight:750;margin-top:20px}.airport-advice dd{margin:4px 0 0;max-width:78ch}.airport-faq{padding:18px 0;border-bottom:1px solid color-mix(in srgb,currentColor 15%,transparent)}.airport-faq summary{cursor:pointer;font-weight:650}.airport-faq p{margin:12px 0 0}.airport-guide a{text-decoration:underline;text-underline-offset:3px}.airport-guide :focus-visible{outline:3px solid currentColor;outline-offset:4px}@media(max-width:600px){.airport-guide{padding:22px 16px}.airport-guide h2{font-size:1.4rem}.airport-provider header{display:block}.airport-provider header span{display:block;margin-top:6px}}
</style>
